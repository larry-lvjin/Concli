<ui:FluentWindow x:Class="ClaudeCodeGUI.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择"
        Width="480" SizeToContent="Height"
        MinHeight="180"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                     ShowMaximize="False" ShowMinimize="False"/>

        <TextBlock x:Name="MessageText" Grid.Row="1"
                   Margin="24,8,24,20" TextWrapping="Wrap" LineHeight="21"
                   FontSize="13.5"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <Border Grid.Row="2" Padding="24,16" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <!-- Order is deliberate: default first, destructive last. The secondary slot sits
                 at the far right, as far from the default button as the row allows, so the
                 irreversible choice is never the one a stray click lands on. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="PrimaryBtn"   Appearance="Primary" MinWidth="112" Margin="0,0,8,0"
                           IsDefault="True" Click="Primary_Click"/>
                <ui:Button x:Name="CancelBtn"    MinWidth="88" Margin="0,0,8,0" IsCancel="True"
                           Click="Cancel_Click"/>
                <ui:Button x:Name="SecondaryBtn" MinWidth="112"
                           Click="Secondary_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
