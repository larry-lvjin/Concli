<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>D:\RFtest\RFtestTools\LVtools</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <!-- One exe that runs on any x64 Windows without a .NET install. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Native dlls (e_sqlite3, WebView2Loader, wpfgfx, ...) and the vendored xterm assets
         go inside the exe too; the host unpacks them to %TEMP%\.net\ConCli\ on first run.
         xterm is found via AppContext.BaseDirectory, which points at that extract dir. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- WPF cannot be IL-trimmed; dropping the framework's satellite resource dirs
         (de, fr, ja, ...) is the size cut that is actually safe. -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
</Project>